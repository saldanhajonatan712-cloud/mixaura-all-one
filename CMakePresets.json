{
  "version": 3,
  "configurePresets": [
    { "name": "vs2022", "displayName": "Visual Studio 2022 x64", "generator": "Visual Studio 17 2022", "architecture": "x64", "binaryDir": "${sourceDir}/build" },
    { "name": "linux", "displayName": "Linux x64", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/build-linux", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "mingw-w64", "displayName": "Windows x64 MinGW", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/build-windows-mingw", "toolchainFile": "${sourceDir}/cmake/mingw-w64.cmake", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "windows-clang", "displayName": "Windows x64 Clang", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/build-windows-clang", "toolchainFile": "${sourceDir}/cmake/clang-windows.cmake", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "vs2022", "configuration": "Release" },
    { "name": "release-linux", "configurePreset": "linux" }
  ]
}
